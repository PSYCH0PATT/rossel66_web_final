# Staging / E2E environment template (secrets — never commit filled values)
# Production stays on Timeweb. Staging uses Vercel project `rossel-music` + branch `staging`.

# --- App ---
NEXT_PUBLIC_SITE_URL=https://rossel-music-git-staging-<team>.vercel.app
NEXT_PUBLIC_BASE_URL=https://rossel-music-git-staging-<team>.vercel.app
FORM_ALLOWED_ORIGINS=https://rossel-music-git-staging-<team>.vercel.app
NODE_ENV=production

# --- Isolated staging Postgres (separate from production Supabase) ---
DATABASE_URL=postgresql://USER:PASS@HOST:5432/rossel_staging?sslmode=require
DIRECT_URL=postgresql://USER:PASS@HOST:5432/rossel_staging?sslmode=require

# --- Auth / cron (staging-only secrets) ---
CRON_SECRET=
AUTH_SECRET=
FORM_DELIVERY_ENCRYPTION_KEY=

# --- Form session / public rate limits (raise for E2E file suites) ---
FORM_SESSION_ACTIVE_PER_IP=20
PUBLIC_FORM_MAX_PER_MIN=200
PUBLIC_FORM_MAX_PER_HOUR=2000

# --- Buildin E2E sandbox (from docs/FORMS_E2E_DATABASE_IDS.env, strip E2E_ prefix) ---
BUILDIN_API_TOKEN=
BUILDIN_API_BASE_URL=https://api.buildin.ai
BUILDIN_DUAL_WRITE=true
PYRUS_WRITE_DISABLED=true
BUILDIN_DB_SUBMISSIONS=
BUILDIN_DB_FORM_BACK_CATALOG=
BUILDIN_DB_FORM_RELEASE_UPLOAD=
BUILDIN_DB_FORM_DISTRIBUTION=
BUILDIN_DB_PII_RF=
BUILDIN_DB_PII_NOT_RF=
# Optional archived child DBs (no longer written)
BUILDIN_DB_SUBMISSION_RELEASES=
BUILDIN_DB_SUBMISSION_TRACKS=
# Optional CRM DBs (can reuse empty / omit if not exercised by form E2E)
BUILDIN_DB_ARTISTS=
BUILDIN_DB_RELEASES=
BUILDIN_DB_TRACKS=
BUILDIN_DB_REPORTS=
BUILDIN_DB_PLAYLISTS=
BUILDIN_DB_AUTOMATION_RUNS=
BUILDIN_DB_ACTIVITY=
BUILDIN_DB_PLAYLIST_HISTORY=

# --- Playwright / CI ---
# VERCEL_AUTOMATION_BYPASS_SECRET=  (Vercel Deployment Protection → Automation bypass)
# E2E_BASE_URL=
# E2E_CRON_SECRET=  (same as CRON_SECRET on staging)
