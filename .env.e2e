# Значения локального тестового стенда. Секретов здесь нет и быть не должно —
# файл отслеживается git, чтобы прогон на другой машине и в CI был идентичным.
#
# Грузится ПЕРВЫМ (playwright.config.ts), поэтому перебивает .env.local с
# прод-кредами: голый `playwright test` не должен случайно уйти в прод.

# Одноразовый Postgres из docker-compose.test.yml
DATABASE_URL=postgresql://rossel:rossel@127.0.0.1:54329/rossel_test
DIRECT_URL=postgresql://rossel:rossel@127.0.0.1:54329/rossel_test
TEST_DATABASE_URL=postgresql://rossel:rossel@127.0.0.1:54329/rossel_test

# Storage: локальный стаб вместо Supabase. Без этой строки lib/supabase.ts молча
# подставляет захардкоженный прод-URL и тесты пишут файлы в живой бакет.
E2E_STORAGE_PORT=54330
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54330
SUPABASE_SERVICE_ROLE_KEY=e2e-stub-key

# На стенде ВСЕ учётки тестовые (e2e-*): без этой строки список артистов в
# админке был бы пуст — и в прогонах, и в визуальном baseline (F-37).
SHOW_TEST_ACCOUNTS=true

# Внешние интеграции выключены целиком
BUILDIN_DUAL_WRITE=false
PYRUS_WRITE_DISABLED=true
E2E_VERIFY_BUILDIN=0
ENABLE_IN_PROCESS_SCHEDULER=false

AUTH_SECRET=e2e-auth-secret-not-a-real-key
CRON_SECRET=e2e-cron-secret
FORM_DELIVERY_ENCRYPTION_KEY=e2e-form-encryption-key

NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:3000
INTERNAL_CRON_BASE_URL=http://127.0.0.1:3000
