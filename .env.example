# 2captcha API ключ для автоматического решения капч
# Получите ключ на https://2captcha.com/
TWOCAPTCHA_API_KEY=your_2captcha_api_key_here

# Замените 'your_2captcha_api_key_here' на ваш реальный API ключ от 2captcha
# Скопируйте этот файл в .env.local и настройте свой ключ

# (Опционально) VK user/service token с доступом к audio — для парсинга обложек плейлистов VK через API
# (страница vk.com/music/playlist/… без токена не содержит URL обложки в HTML — только SPA).
# VK_PLAYLIST_COVER_ACCESS_TOKEN=
