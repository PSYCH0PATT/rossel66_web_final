# Скопируйте в .env.local и заполните. Не коммитьте секреты.

DATABASE_URL=
CRON_SECRET=
AUTH_SECRET=
# ALLOW_LEGACY_UNSIGNED_SESSION=true

NEXT_PUBLIC_BASE_URL=
INTERNAL_CRON_BASE_URL=

SFTP_HOST=
SFTP_PORT=
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_REMOTE_PATH=
SFTP_REMOTE_FLASH_PATH=

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

VK_PLAYLIST_COVER_ACCESS_TOKEN=
YANDEX_MUSIC_OAUTH_TOKEN=
TWOCAPTCHA_API_KEY=
BRIGHT_DATA_RESIDENTIAL_USERNAME=
BRIGHT_DATA_RESIDENTIAL_PASSWORD=
PROXY_HOST=
PROXY_PORT=

PYRUS_LOGIN=
PYRUS_SECRET_KEY=
PYRUS_API_KEY=

# Buildin (forms dual-write + ops CRM). Never expose token to the client.
# MCP in Cursor is NOT a substitute — create Integration token in Buildin UI.
BUILDIN_API_TOKEN=
# Alias used by Buildin CLI / skill buildin-cli:
# BUILDIN_TOKEN=
BUILDIN_API_BASE_URL=https://api.buildin.ai
# Alias used by Buildin CLI:
# BUILDIN_BASE_URL=https://api.buildin.ai
BUILDIN_DUAL_WRITE=true
PYRUS_WRITE_DISABLED=false
BUILDIN_DB_SUBMISSIONS=
BUILDIN_DB_ARTISTS=
BUILDIN_DB_RELEASES=
BUILDIN_DB_TRACKS=
BUILDIN_DB_REPORTS=
BUILDIN_DB_PLAYLISTS=
BUILDIN_DB_AUTOMATION_RUNS=
BUILDIN_DB_PII_RF=
BUILDIN_DB_PII_NOT_RF=
BUILDIN_DB_ACTIVITY=
BUILDIN_DB_PLAYLIST_HISTORY=
BUILDIN_DB_SUBMISSION_RELEASES=
BUILDIN_DB_SUBMISSION_TRACKS=

# Form delivery ledger encryption (AES-256-GCM). Generate: openssl rand -hex 32
FORM_DELIVERY_ENCRYPTION_KEY=
FORM_ALLOWED_ORIGINS=
NEXT_PUBLIC_SITE_URL=

# Staging / E2E — see docs/FORMS_STAGING.env.example and docs/FORMS_TESTING.md
# E2E_BASE_URL=
# VERCEL_AUTOMATION_BYPASS_SECRET=

ENABLE_IN_PROCESS_SCHEDULER=true
