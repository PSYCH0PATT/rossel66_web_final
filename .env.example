# Скопируйте в .env.local и заполните. Не коммитьте секреты.

DATABASE_URL=
CRON_SECRET=
AUTH_SECRET=
# ALLOW_LEGACY_UNSIGNED_SESSION=true

NEXT_PUBLIC_BASE_URL=
INTERNAL_CRON_BASE_URL=

SFTP_HOST=
SFTP_PORT=
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_REMOTE_PATH=
SFTP_REMOTE_FLASH_PATH=

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

VK_PLAYLIST_COVER_ACCESS_TOKEN=
YANDEX_MUSIC_OAUTH_TOKEN=

PYRUS_LOGIN=
PYRUS_SECRET_KEY=
PYRUS_API_KEY=

# Buildin (forms dual-write + ops CRM). Never expose token to the client.
# MCP in Cursor is NOT a substitute — create Integration token in Buildin UI.
BUILDIN_API_TOKEN=
# Alias used by Buildin CLI / skill buildin-cli:
# BUILDIN_TOKEN=
BUILDIN_API_BASE_URL=https://api.buildin.ai
# Alias used by Buildin CLI:
# BUILDIN_BASE_URL=https://api.buildin.ai
BUILDIN_DUAL_WRITE=true
PYRUS_WRITE_DISABLED=false
BUILDIN_DB_SUBMISSIONS=
BUILDIN_DB_FORM_BACK_CATALOG=
BUILDIN_DB_FORM_RELEASE_UPLOAD=
BUILDIN_DB_FORM_DISTRIBUTION=
BUILDIN_DB_ARTISTS=
BUILDIN_DB_RELEASES=
BUILDIN_DB_TRACKS=
BUILDIN_DB_REPORTS=
BUILDIN_DB_PLAYLISTS=
BUILDIN_DB_AUTOMATION_RUNS=
BUILDIN_DB_PII_RF=
BUILDIN_DB_PII_NOT_RF=
BUILDIN_DB_ACTIVITY=
BUILDIN_DB_PLAYLIST_HISTORY=
# Archived child intake DBs (no longer written by form sessions)
BUILDIN_DB_SUBMISSION_RELEASES=
BUILDIN_DB_SUBMISSION_TRACKS=

# Form delivery ledger encryption (AES-256-GCM). Generate: openssl rand -hex 32
FORM_DELIVERY_ENCRYPTION_KEY=
FORM_ALLOWED_ORIGINS=
NEXT_PUBLIC_SITE_URL=

# Staging / E2E — see docs/FORMS_STAGING.env.example and docs/FORMS_TESTING.md
# E2E_BASE_URL=
# VERCEL_AUTOMATION_BYPASS_SECRET=

# Внутрипроцессный планировщик (lib/scheduler.ts). Выключен намеренно.
# Расписание живёт в crontab — entrypoint.sh запускает crond безусловно, поэтому
# при true каждая задача выполнялась дважды. Все задачи планировщика теперь есть
# в crontab, включая аналитику и обложки, которые раньше были только здесь.
# Сам модуль оставлен для ручного запуска.
ENABLE_IN_PROCESS_SCHEDULER=false

# Внутренние витрины /dev/ui и /dev/design-map. В dev-сборке открыты всегда,
# в production-сборке — только при "1". На бою переменной нет, значит закрыто;
# на стейдже включается одной строкой в панели Vercel, без правки кода.
# Без префикса NEXT_PUBLIC_ намеренно: читается только на сервере.
# ENABLE_DEV_PAGES=1
