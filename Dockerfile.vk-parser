FROM python:3.11-slim

# Установка системных зависимостей
RUN apt-get update && apt-get install -y \
    wget \
    gnupg \
    unzip \
    curl \
    sqlite3 \
    xvfb \
    && rm -rf /var/lib/apt/lists/*

# Установка Chromium (ARM64 совместимый)
RUN apt-get update \
    && apt-get install -y chromium chromium-driver \
    && rm -rf /var/lib/apt/lists/*

# Установка Python зависимостей
# ВАЖНО: blinker<1.8 нужен для совместимости с selenium-wire
RUN pip install --no-cache-dir \
    selenium \
    webdriver-manager \
    'blinker<1.8' \
    selenium-wire \
    2captcha-python

# Создание рабочей директории
WORKDIR /app

# Копирование файлов парсера
COPY parsers/vk_parser_linux.py /app/parsers/
COPY temp_vk_config.json /app/

# Создание директории для БД
RUN mkdir -p /app/data

# Создаем скрипт запуска с Xvfb
RUN echo '#!/bin/bash\nXvfb :99 -screen 0 1920x1080x24 &\nexport DISPLAY=:99\npython3 parsers/vk_parser_linux.py temp_vk_config.json' > /app/start.sh && chmod +x /app/start.sh

# Запуск парсера через Xvfb
CMD ["/bin/bash", "/app/start.sh"]

