# Логи: /app/logs/cron.log

# Koala: каждый день в 12:00 и 20:00 МСК -> 09:00 и 17:00 UTC
0 9,17 * * * curl -X POST http://127.0.0.1:3000/api/koala-parser >> /app/logs/cron.log 2>&1

# Zvonko: каждый день в 14:00 МСК -> 11:00 UTC (1 страница)
0 11 * * * curl -X POST http://127.0.0.1:3000/api/zvonko-parser -H "Content-Type: application/json" -d '{"action": "parse", "pagesToParse": 1}' >> /app/logs/cron.log 2>&1

# SFTP плейлисты: 16:00 и 00:30 МСК -> 13:00 и 21:30 UTC (скрипт читает CRON_SECRET из /tmp/.cron_secret)
0 13 * * * /app/scripts/cron-sftp.sh >> /app/logs/cron.log 2>&1
30 21 * * * /app/scripts/cron-sftp.sh >> /app/logs/cron.log 2>&1

# Buildin outbox retries: каждые 5 минут
*/5 * * * * curl -s -H "Authorization: Bearer $(cat /tmp/.cron_secret 2>/dev/null)" "http://127.0.0.1:3000/api/cron/buildin-outbox?limit=20" >> /app/logs/cron.log 2>&1
