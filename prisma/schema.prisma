// Prisma schema для проекта rossel-music

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id
  username   String   @unique
  name       String
  email      String   @default("")
  role       String
  password   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  avatarUrl  String?
  vkMusicUrl String?
  yandexMusicUrl String?
  spotifyUrl String?
  fio        String?
  fioShort   String?
  contract   String?
  percentage Int?
  verified   Boolean  @default(true)

  @@index([role, verified])
}

model Release {
  id                String   @id
  title             String
  artistId          String?
  releaseDate       String
  releaseDateSort   DateTime?
  type              String?
  coverUrl          String?
  upc               String?
  status            String?
  koalaId           String?
  bandlinkUrl       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tracks            Json     @default("[]")
  featuredArtistIds String[] @default([])
  featuredArtistNames String[] @default([])
  metadata          Json?

  @@index([artistId])
  @@index([koalaId])
  @@index([artistId, createdAt])
  @@index([releaseDateSort])
  @@index([artistId, releaseDateSort])
}

model Report {
  id           String   @id
  quarter      String
  artistId     String?
  artistName   String
  fileName     String
  filePath     String
  uploadedAt   DateTime @default(now())
  processed    Boolean  @default(true)
  year         Int?
  totalPlays   Int?
  totalAmount  Float?
  isPaid       Boolean?
  isSigned     Boolean?
  isAcknowledged Boolean? @default(false)
  acknowledgedAt DateTime?
  isRegistered Boolean?
  status       String?
  uploadDate   String?
  fileUrl      String?

  @@unique([artistId, quarter, year], map: "Report_artistId_quarter_year_key")
  @@index([artistId])
  @@index([quarter])
  @@index([artistId, isRegistered])
  @@index([quarter, isRegistered])
  @@index([artistId, quarter])
}

model Activity {
  id          String   @id
  type        String
  userId      String?
  userRole    String
  title       String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([userRole])
  @@index([createdAt])
}

model Playlist {
  id              String    @id
  playlistUrl     String
  playlistName    String
  platform        String
  artistName      String
  artistId        String?
  trackData       Json      @default("[]")
  firstSeenDate   String?
  lastSeenDate    String?
  coverUrl        String?
  coverFetchedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([playlistUrl, playlistName, artistName])
  @@index([artistId])
  @@index([platform])
  @@index([artistId, platform])
  @@index([coverFetchedAt])
}

model AnalyticsArtistAlias {
  id          String   @id @default(cuid())
  trackArtist String
  artistId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([trackArtist])
  @@index([artistId])
}

model StreamAnalytics {
  id               String   @id @default(cuid())
  date             DateTime
  dsp              String
  length           String
  source           String
  isrc             String
  trackArtist      String
  trackName        String
  albumTitle       String
  cpline           String?
  albumReleaseDate String?
  daysSinceRelease Int?
  streams          Int
  artistId         String?

  isMonthlyAggregate Boolean @default(false)
  month            Int?
  year             Int?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([date])
  @@index([artistId])
  @@index([isrc])
  @@index([dsp])
  @@index([isMonthlyAggregate])
  @@index([year, month])
  @@index([artistId, date])
  @@index([artistId, isMonthlyAggregate, year, month])
  @@unique([date, isrc, dsp, length, source, isMonthlyAggregate], map: "stream_analytics_flash_row_key")
}

/** Parser cookies (Bandlink/VK) — survives Timeweb ephemeral disk rebuild */
model ParserCookie {
  id        String   @id @default(cuid())
  platform  String
  name      String
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, name])
  @@index([platform])
}

/**
 * История запусков парсеров. Раньше жила в SQLite (parsing_history в
 * vk_playlists.db / bandlink_playlists.db) — терялась при каждом ребилде
 * Timeweb и требовала нативный sqlite3. Теперь в Postgres.
 */
model ParserRun {
  id             String    @id @default(cuid())
  /** vk | bandlink */
  parserType     String
  /** Список артистов через запятую (как показывает UI) */
  artists        String
  playlistsFound Int       @default(0)
  playlistsAdded Int       @default(0)
  errors         String?   @db.Text
  /** running | completed | failed */
  status         String    @default("running")
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([parserType, startedAt])
  @@index([status])
  @@index([startedAt])
}

/** Parser run status / cookie alerts — survives Timeweb rebuild */
model ParserRunStatus {
  platform          String   @id
  status            String   @default("idle")
  lastRun           DateTime?
  needsNewCookies   Boolean  @default(false)
  failedAttempts    Int      @default(0)
  lastError         String?
  updatedAt         DateTime @updatedAt
}

/**
 * Canonical form submission (source of truth for dual-write to Pyrus + Buildin).
 * Payload is stored as JSON; files live in Pyrus/Buildin/Supabase depending on adapter.
 */
model FormSubmission {
  id              String   @id @default(cuid())
  /** release_upload | catalog_upload | distribution | data_rf | data_not_rf */
  formType        String
  /** pending | dual_writing | completed | partial | failed */
  status          String   @default("pending")
  idempotencyKey  String   @unique
  title           String
  contactEmail    String?
  contactTelegram String?
  artistNickname  String?
  /** Canonical validated payload (no file binaries) */
  payload         Json
  /** Snapshot of file metadata: name, size, contentType, adapters' file refs */
  filesMeta       Json     @default("[]")
  pyrusTaskId     String?
  buildinPageId   String?
  lastError       String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  externalIds BuildinExternalId[]
  outbox      BuildinOutbox[]

  @@index([formType, createdAt])
  @@index([status, createdAt])
  @@index([pyrusTaskId])
  @@index([buildinPageId])
}

/** Maps local entity IDs to Buildin page/database record IDs */
model BuildinExternalId {
  id             String   @id @default(cuid())
  /** submission | artist | release | track | report | playlist | activity | parser_run */
  entityType     String
  localId        String
  buildinPageId  String
  buildinDbKey   String?
  version        Int      @default(1)
  lastSyncedAt   DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  submissionId   String?
  submission     FormSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@unique([entityType, localId])
  @@unique([buildinPageId])
  @@index([entityType, buildinPageId])
  @@index([submissionId])
}

/** Reliable outbox for Buildin writes / sync jobs */
model BuildinOutbox {
  id           String    @id @default(cuid())
  /** create_submission | sync_artist | sync_release | sync_report | sync_playlist | sync_activity | sync_parser */
  eventType    String
  payload      Json
  /** pending | processing | done | failed | dead */
  status       String    @default("pending")
  attempts     Int       @default(0)
  maxAttempts  Int       @default(8)
  nextAttemptAt DateTime @default(now())
  lastError    String?   @db.Text
  submissionId String?
  submission   FormSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  processedAt  DateTime?

  @@index([status, nextAttemptAt])
  @@index([eventType, status])
  @@index([submissionId])
}

/** Playlist change history (was stubbed empty before) */
model PlaylistHistory {
  id            String   @id @default(cuid())
  playlistUrl   String
  playlistName  String
  platform      String
  changeType    String
  changeDate    String
  artistName    String?
  artistId      String?
  trackTitle    String?
  oldPosition   Int?
  newPosition   Int?
  metadata      Json?
  buildinPageId String?
  createdAt     DateTime @default(now())

  @@index([changeDate])
  @@index([artistId])
  @@index([playlistUrl])
  @@index([changeType])
  @@index([createdAt])
}
