// Prisma schema для проекта rossel-music

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id
  username   String   @unique
  name       String
  email      String   @default("")
  role       String
  password   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  avatarUrl  String?
  vkMusicUrl String?
  yandexMusicUrl String?
  spotifyUrl String?
  fio        String?
  fioShort   String?
  contract   String?
  percentage Int?
  verified   Boolean  @default(true)

  @@index([role, verified])
}

model Release {
  id                String   @id
  title             String
  artistId          String?
  releaseDate       String
  type              String?
  coverUrl          String?
  upc               String?
  status            String?
  koalaId           String?
  bandlinkUrl       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tracks            Json     @default("[]")
  featuredArtistIds String[] @default([])
  featuredArtistNames String[] @default([])
  metadata          Json?

  @@index([artistId])
  @@index([koalaId])
  @@index([artistId, createdAt])
}

model Report {
  id           String   @id
  quarter      String
  artistId     String?
  artistName   String
  fileName     String
  filePath     String
  uploadedAt   DateTime @default(now())
  processed    Boolean  @default(true)
  year         Int?
  totalPlays   Int?
  totalAmount  Float?
  isPaid       Boolean?
  isSigned     Boolean?
  isRegistered Boolean?
  status       String?
  uploadDate   String?
  fileUrl      String?

  @@index([artistId])
  @@index([quarter])
  @@index([artistId, isRegistered])
  @@index([quarter, isRegistered])
  @@index([artistId, quarter])
}

model Activity {
  id          String   @id
  type        String
  userId      String?
  userRole    String
  title       String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([userRole])
  @@index([createdAt])
}

model Playlist {
  id              String    @id
  playlistUrl     String
  playlistName    String
  platform        String
  artistName      String
  artistId        String?
  trackData       Json      @default("[]")
  firstSeenDate   String?
  lastSeenDate    String?
  coverUrl        String?
  coverFetchedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([playlistUrl, playlistName, artistName])
  @@index([artistId])
  @@index([platform])
  @@index([artistId, platform])
  @@index([coverFetchedAt])
}

model StreamAnalytics {
  id               String   @id @default(cuid())
  date             DateTime
  dsp              String
  length           String
  source           String
  isrc             String
  trackArtist      String
  trackName        String
  albumTitle       String
  cpline           String?
  albumReleaseDate String?
  daysSinceRelease Int?
  streams          Int
  artistId         String?

  isMonthlyAggregate Boolean @default(false)
  month            Int?
  year             Int?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([date])
  @@index([artistId])
  @@index([isrc])
  @@index([dsp])
  @@index([isMonthlyAggregate])
  @@index([year, month])
  @@index([artistId, date])
  @@index([artistId, isMonthlyAggregate, year, month])
  @@unique([date, isrc, dsp, length, source, isMonthlyAggregate], map: "stream_analytics_flash_row_key")
}
