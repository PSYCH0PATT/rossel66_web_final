# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
chrome_profiles/
__pycache__/
*.pyc
*.db
temp_*_config.json

# Parser configs with credentials
parsers/koala_config.json
parsers/bandlink_config*.json
parsers/brightdata_test_config.json
parsers/test_config*.json

# Backup files with sensitive data
data/users_backup_*.json
